# Latest Spectra installers on GitHub Releases (used by /downloads/{macos,windows,linux}).
# Default is QuentinStoll/SpectraDsp, where CI publishes Spectra-*.exe/.pkg/.run.
GITHUB_RELEASES_REPO=QuentinStoll/SpectraDsp

# Optional. Raise the GitHub API rate limit, or required if the releases repo is private.
GITHUB_RELEASES_TOKEN=
